# Copy to .env and fill in.
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Long random string used to sign JWTs (required for real use).
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas connection string for cloud sync.
# Leave empty in dev to use a zero-setup in-memory database (data is not persisted).
MONGODB_URI=

# SMTP for password-reset emails. Leave empty in dev — the OTP is logged to the
# backend console instead of being emailed.
# For Gmail: enable 2FA, create an App Password, and use it as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pursuit <no-reply@pursuit.app>

# Secret for the external reminder cron (POST /api/internal/run-reminders).
# Set this in production and pass the same value from your cron service (e.g.
# cron-job.org) as an `x-cron-secret` header. Leave empty to disable the endpoint.
CRON_SECRET=

# How often the in-process scheduler checks for due reminders (minutes) and how
# far back it looks so a first run / post-downtime catch-up doesn't flood inboxes.
REMINDER_CHECK_MINUTES=15
REMINDER_LOOKBACK_DAYS=3
